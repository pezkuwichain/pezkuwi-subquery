{
  "name": "subquery-pezkuwi",
  "version": "1.0.0",
  "packageManager": "yarn@4.12.0",
  "description": "Pezkuwi SubQuery - Staking, governance, NominationPools, transfers indexer for PezWallet",
  "main": "dist/index.js",
  "scripts": {
    "build": "./node_modules/.bin/subql build",
    "start:docker": "docker-compose pull && docker-compose up --remove-orphans",
    "codegen": "./node_modules/.bin/subql codegen",
    "validate": "./node_modules/.bin/subql validate",
    "local-publish": "cd ./scripts && ./local-publish.sh"
  },
  "files": [
    "dist",
    "schema.graphql",
    "pezkuwi.yaml",
    "pezkuwi-assethub.yaml",
    "pezkuwi-governance.yaml"
  ],
  "author": "Pezkuwi Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@pezkuwi/api": "^16.5.39",
    "@pezkuwi/api-augment": "^16.5.39",
    "@pezkuwi/api-derive": "^16.5.39",
    "@pezkuwi/keyring": "^14.0.26",
    "@pezkuwi/types": "^16.5.39",
    "@pezkuwi/types-augment": "^16.5.39",
    "@pezkuwi/types-codec": "^16.5.39",
    "@pezkuwi/types-create": "^16.5.39",
    "@pezkuwi/util": "^14.0.26",
    "@pezkuwi/util-crypto": "^14.0.26",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@subql/cli": "^6.6.3",
    "@subql/common-substrate": "^4.5.5",
    "@subql/types": "^3.15.0",
    "@types/jest": "^29.5.1",
    "jest": "^29.5.0",
    "prettier": "3.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "resolutions": {
    "ipfs-unixfs": "6.0.6",
    "@modelcontextprotocol/sdk@npm:1.24.3": "npm:^1.31.0",
    "axios@npm:^0.27.2": "npm:^0.34.0",
    "braces@npm:^3.0.3": "npm:@pezkuwi/braces@^3.0.4",
    "package-json@npm:^6.3.0": "npm:^7.0.0",
    "serialize-javascript@npm:^6.0.2": "npm:^7.0.5",
    "simple-git@npm:^3.28.0": "npm:^4.0.1",
    "tmp@npm:^0.0.33": "npm:^0.2.6",
    "uuid@npm:^8.3.2": "npm:^11.1.1",
    "ws@npm:8.18.0": "npm:^8.21.0"
  }
